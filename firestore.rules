rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these Google accounts can read/write clinic data. Edit the list, then Publish in Firebase Console.
    function staff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'REPLACE_WITH_DOCTOR_GMAIL@gmail.com'
          // , 'receptionist@gmail.com'
        ];
    }

    // Fields a patient may submit from the public QR registration page.
    function validReg() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','age','sex','mobile','reason','allergies','chronic','address','consent','lang','created'])
        && d.keys().hasAll(['name','mobile','consent','created'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.mobile is string && d.mobile.matches('^[0-9]{10}$')
        && d.consent == true
        && d.created == request.time
        && d.get('age','') is string && d.get('age','').size() <= 3
        && d.get('sex','') is string && d.get('sex','').size() <= 10
        && d.get('reason','') is string && d.get('reason','').size() <= 300
        && d.get('allergies','') is string && d.get('allergies','').size() <= 200
        && d.get('chronic','') is string && d.get('chronic','').size() <= 200
        && d.get('address','') is string && d.get('address','').size() <= 300
        && d.get('lang','en') in ['en','mr'];
    }

    match /clinics/main/{col}/{id} {
      allow read, write: if staff() && col in ['patients','visits','medicines','appointments','payments','templates','meta','documents','docdata'];
      // patients (not logged in) can only CREATE a registration; staff read/remove them
      allow create: if col == 'registrations' && validReg();
      allow read, delete: if staff() && col == 'registrations';
      // activity log: staff can add and read, nobody can edit or delete
      allow read, create: if staff() && col == 'audit';
    }
  }
}
